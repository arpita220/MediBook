		},
		{
			"label": "Verify Notification Schema",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"const { db, initDb } = require('./db/database'); initDb((err) => { if (err) { console.error(err.message); process.exitCode = 1; db.close(); return; } db.get(\"SELECT name FROM sqlite_master WHERE type = 'trigger' AND name = ?\", ['notify_patient_on_appointment_status'], (queryErr, row) => { if (queryErr || !row) { console.error(queryErr ? queryErr.message : 'Notification trigger was not created'); process.exitCode = 1; } else { console.log('Notification table and appointment status trigger initialized.'); } db.close(); }); });"
			],
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Verify Notification DB Setup",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"const { db, initDb } = require(\"./db/database\"); initDb((err) => { if (err) { console.error(err.message); process.exitCode = 1; db.close(); return; } db.get(\"SELECT name FROM sqlite_master WHERE type = ? AND name = ?\", [\"trigger\", \"notify_patient_on_appointment_status\"], (queryErr, row) => { if (queryErr || !row) { console.error(queryErr ? queryErr.message : \"Notification trigger was not created\"); process.exitCode = 1; } else { console.log(\"Notification table and appointment status trigger initialized.\"); } db.close(); }); });"
			],
			"problemMatcher": [],
			"group": "build"
		},
